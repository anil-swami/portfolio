---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<section class="section" id="process">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow"><Icon name="ClipboardList" size={15} /> How it works</span>
      <h2>From first call to <span class="grad-text--light">live website</span></h2>
    </div>
    <ol class="steps">
      {site.steps.map((s, i) => (
        <li class="step reveal" data-tint={s.tint} style={`--d:${i * 0.12}s`}>
          <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="step__icon"><Icon name={s.icon} size={28} /></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; }
  .steps::before { content: ''; position: absolute; top: 46px; left: 12%; right: 12%; height: 2px; background-image: linear-gradient(90deg, var(--line) 50%, transparent 0); background-size: 14px 2px; }
  .step { position: relative; text-align: center; padding: 0 .5rem; }
  .step__icon { position: relative; z-index: 1; width: 92px; height: 92px; margin: 0 auto 1.3rem; border-radius: 50%; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--tint), color-mix(in srgb, var(--tint) 65%, black)); box-shadow: 0 0 0 10px color-mix(in srgb, var(--tint) 14%, white), 0 18px 30px -12px var(--tint); transition: transform .4s ease; }
  .step:hover .step__icon { transform: translateY(-6px) scale(1.04); }
  .step__num { position: absolute; z-index: 2; top: -6px; left: calc(50% + 26px); font-family: var(--font-head); font-weight: 700; font-size: .85rem; background: var(--deep); color: #fff; padding: .2rem .55rem; border-radius: 999px; }
  .step h3 { margin-bottom: .4rem; }
  .step p { color: var(--muted); font-size: .96rem; }
  @media (max-width: 960px) { .steps { grid-template-columns: repeat(2, 1fr); row-gap: 2.5rem; } .steps::before { display: none; } }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; row-gap: 1.4rem; }
    .step { display: grid; grid-template-columns: auto 1fr; column-gap: 1.1rem; text-align: left; padding: 0; }
    .step__icon { grid-row: span 2; width: 64px; height: 64px; margin: 0; box-shadow: 0 0 0 7px color-mix(in srgb, var(--tint) 14%, white); }
    .step__num { left: 46px; top: -8px; font-size: .75rem; }
    .step h3 { margin: .2rem 0; }
    .step p { margin: 0; }
  }
</style>
