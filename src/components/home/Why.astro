---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<section class="section section--warm" id="why">
  <div class="wrap why">
    <div class="why__intro reveal">
      <span class="eyebrow"><Icon name="CircleCheck" size={15} /> Why work with me</span>
      <h2>A website that works as hard as <span class="grad-text--light">you do</span></h2>
      <p>Most small-business sites are slow, hard to find on Google and impossible to update. Mine are built the other way round.</p>
      <a class="btn" href="/#contact">Get a quote <Icon name="ArrowRight" size={18} /></a>
    </div>
    <ul class="why__list">
      {site.why.map((w, i) => (
        <li class="reveal" data-tint={w.tint} style={`--d:${i * 0.1}s`}>
          <span class="why__icon"><Icon name={w.icon} size={22} /></span>
          <div><h3>{w.title}</h3><p>{w.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { display: grid; grid-template-columns: .85fr 1.15fr; gap: 3.5rem; align-items: center; }
  .why__intro p { color: var(--muted); font-size: 1.1rem; margin-bottom: 1.8rem; }
  .why__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .why__list li { display: flex; gap: 1rem; padding: 1.3rem; background: #fff; border-radius: var(--radius); border: 1px solid #f3dcd2; transition: transform .3s ease, box-shadow .3s ease; }
  .why__list li:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .why__list h3 { font-size: 1.02rem; margin-bottom: .3rem; }
  .why__list p { color: var(--muted); font-size: .94rem; margin: 0; }
  .why__icon { flex: none; width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; color: var(--tint); background: color-mix(in srgb, var(--tint) 13%, white); }
  @media (max-width: 960px) { .why { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 560px) { .why__list { grid-template-columns: 1fr; } }
</style>
