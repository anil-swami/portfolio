---
import { whatsappLink } from '../data/site';
const href = whatsappLink();
---
{href && (
  <a class="wa-float" href={href} target="_blank" rel="noopener" aria-label="Chat with me on WhatsApp">
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
      <path fill="currentColor" d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.3 28.8l6.6-1.7A12.7 12.7 0 1 0 16 3.2Zm0 23.2c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.5 10.5 0 1 1 16 26.4Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.7c-.3-.6.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.4 4.7 2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5 0-.2-.3-.3-.6-.4Z"/>
    </svg>
  </a>
)}

<style>
  .wa-float {
    position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 60; width: 58px; height: 58px; border-radius: 50%;
    display: grid; place-items: center; background: #1fae5b; color: #fff; box-shadow: 0 14px 30px -10px rgba(31, 174, 91, .75);
    transition: transform .25s ease;
  }
  .wa-float::before { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 2px solid #1fae5b; animation: wa-pulse 2.4s ease-out infinite; }
  .wa-float:hover { transform: translateY(-3px); }
  @keyframes wa-pulse { from { transform: scale(1); opacity: .8; } to { transform: scale(1.45); opacity: 0; } }
</style>
